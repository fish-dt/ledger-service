# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it. These are read by docker-compose.yml and (for local
# `mvn spring-boot:run` without Docker) by application.yml directly.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ledger
DB_USER=ledger
# Pick a real password for anything beyond local throwaway dev.
DB_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379

SERVER_PORT=8080

# Origin(s) allowed to call the API from a browser. Comma-separated for
# more than one. Must match wherever the frontend is actually running.
CORS_ALLOWED_ORIGINS=http://localhost:3000
