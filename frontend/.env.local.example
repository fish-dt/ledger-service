# Where the Spring Boot ledger-service API is running.
# Copy this file to .env.local and adjust if you're not running the default
# `docker compose up` setup.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Set to "true" on a public deploy that has no live backend behind it.
# Every API call then serves from an in-memory fixture store instead
# (lib/demo-data.ts) and a "Demo data" banner shows in the UI.
NEXT_PUBLIC_DEMO_MODE=false
